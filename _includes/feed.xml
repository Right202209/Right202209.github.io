{%- include lang.html -%}
{%- assign _posts = site.posts | where: "lang", L -%}
{%- assign _lim = site.feed_limit | default: 20 -%}
{%- assign _alt_feed = site.data.i18n[alt].feed -%}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ L }}">
  <title>{{ site.title | xml_escape }}{% if L != site.lang %} ({{ t.label }}){% endif %}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ t.home | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ L }}"/>
  {%- if _alt_feed %}
  <link href="{{ _alt_feed | absolute_url }}" rel="alternate" type="application/atom+xml" hreflang="{{ alt }}"/>
  {%- endif %}
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <author><name>{{ site.author | xml_escape }}</name>{% if site.email %}<email>{{ site.email | xml_escape }}</email>{% endif %}</author>
  <generator uri="https://jekyllrb.com/">Jekyll</generator>
  {%- for post in _posts limit: _lim %}
  <entry xml:lang="{{ L }}">
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    {%- if post.description %}
    <summary type="html">{{ post.description | xml_escape }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
