---
layout: null
---
{% assign docs = site.posts | concat: site.reading %}
[
{% for post in docs %}
  {"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "date": {{ post.date | date: "%Y-%m-%d" | jsonify }}, "lang": {{ post.lang | jsonify }}, "text": {{ post.content | strip_html | strip_newlines | truncatewords: 60 | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
{%- comment -%} Life in Weeks: every public event jumps straight to its week. {%- endcomment -%}
{%- assign W = site.data.weeks -%}
{%- assign emitted = docs.size -%}
{%- if W and W.enabled != false -%}
{%- for lang in site.languages -%}
  {%- assign wpage = site.pages | where: "ref", "weeks" | where: "lang", lang | first -%}
  {%- unless wpage -%}{%- continue -%}{%- endunless -%}
  {%- assign wt = site.data.i18n[lang] -%}
  {%- for e in W.events -%}
    {%- if e.private -%}{%- continue -%}{%- endif -%}
    {%- assign d = e.date | date: "%Y-%m-%d" -%}
    {%- if lang == "en" -%}{%- assign lbl = e.en | default: e.zh -%}{%- else -%}{%- assign lbl = e.zh | default: e.en -%}{%- endif -%}
    {%- capture ttl -%}{% if e.emoji %}{{ e.emoji }} {% endif %}{{ lbl }}{%- endcapture -%}
    {%- capture url -%}{{ wpage.url | relative_url }}#ev-{{ d }}{%- endcapture -%}
    {%- if emitted > 0 %},{% endif %}{%- assign emitted = emitted | plus: 1 %}
  {"title": {{ ttl | jsonify }}, "url": {{ url | jsonify }}, "date": {{ d | jsonify }}, "lang": {{ lang | jsonify }}, "text": {{ wt.weeks_title | append: " " | append: lbl | jsonify }}}
  {%- endfor -%}
{%- endfor -%}
{%- endif %}
]
